\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Inclinación y FOV para $\Phi _{1/2}=30^\circ $, $K=9$, área nominal y ruido constante. Las curvas condicionales no sustituyen la comparación con cobertura completa.}}{10}{figure.1}\protected@file@percent }
