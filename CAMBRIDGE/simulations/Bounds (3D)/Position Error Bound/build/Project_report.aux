\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=45^\circ $. La FOV afecta el conjunto visible, no una ganancia de concentrador implícita.}}{11}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=60^\circ $. La inclinación equilibra diversidad angular, componente radial y visibilidad espacial.}}{11}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=75^\circ $. El mejor cono muestreado tiene inclinación $40^\circ $; eso no implica que todas las normales del posterior refinamiento conserven ese ángulo.}}{12}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Área del PD}{12}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Benchmark: los conos de $17,31,35,40$ grados permanecen congelados por semiángulo LED. Comparación entre $N_i=1000$ y $M=9000$ muestras totales. La cobertura y el carácter no anidado de los conos son esenciales para interpretar los puntos de $K$ pequeño.}}{13}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Benchmark refinado: patrones individuales congelados, $K=14$, FOV $85^\circ $, $N_i=1000$. La pendiente inversa con área es una consecuencia del modelo de ruido constante, no una conclusión sobre el área óptima de un circuito receptor real.}}{14}{figure.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Distribución espacial}{14}{subsection.7.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Configuraciones refinadas a $z=0.8$ m, con $K=14$, FOV $85^\circ $ y área $26.4\ \mathrm  {mm}^2$. Cada pixel representa una cota de posición de tres coordenadas.}}{15}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Mejor configuración muestreada, $\Phi _{1/2}=75^\circ $, a tres alturas y dos áreas. El tiempo de adquisición por orientación y la varianza óptica permanecen constantes.}}{16}{figure.8}\protected@file@percent }
