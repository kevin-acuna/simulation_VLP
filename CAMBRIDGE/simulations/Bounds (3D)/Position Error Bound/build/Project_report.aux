\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Inclinación y FOV para $\Phi _{1/2}=30^\circ $, $K=9$, área nominal y ruido constante. Las curvas condicionales no sustituyen la comparación con cobertura completa.}}{14}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=45^\circ $. La FOV afecta el conjunto visible, no una ganancia de concentrador implícita.}}{14}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=60^\circ $. La inclinación equilibra diversidad angular, componente radial y visibilidad espacial.}}{15}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mismo protocolo con $\Phi _{1/2}=75^\circ $. El mejor cono muestreado tiene inclinación $40^\circ $; eso no implica que todas las normales del posterior refinamiento conserven ese ángulo.}}{15}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Benchmark: los conos de $17,31,35,40$ grados permanecen congelados por semiángulo LED. Comparación entre $N_i=1000$ y $M=9000$ muestras totales. La cobertura y el carácter no anidado de los conos son esenciales para interpretar los puntos de $K$ pequeño.}}{16}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Área del PD}{17}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Benchmark refinado: patrones individuales congelados, $K=14$, FOV $85^\circ $, $N_i=1000$. La pendiente inversa con área es una consecuencia del modelo de ruido constante, no una conclusión sobre el área óptima de un circuito receptor real.}}{17}{figure.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Distribución espacial}{17}{subsection.7.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Configuraciones refinadas a $z=0.8$ m, con $K=14$, FOV $85^\circ $ y área $26.4\ \mathrm  {mm}^2$. Cada pixel representa una cota de posición de tres coordenadas.}}{18}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Mejor configuración muestreada, $\Phi _{1/2}=75^\circ $, a tres alturas y dos áreas. El tiempo de adquisición por orientación y la varianza óptica permanecen constantes.}}{19}{figure.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Viabilidad con tilt limitado y nuevos experimentos}{20}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Qué significa fijar el tilt en tres grados}{20}{subsection.8.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Criterio de viabilidad y búsqueda conjunta}{20}{subsection.8.2}\protected@file@percent }
\newlabel{eq:viability}{{26}{20}{Criterio de viabilidad y búsqueda conjunta}{equation.26}{}}
\newlabel{eq:required_area}{{27}{20}{Criterio de viabilidad y búsqueda conjunta}{equation.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Results with the Active Nominal Hardware Configuration}{21}{subsection.8.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Qué aportan otros patrones, potencia y muestras}{21}{subsection.8.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Búsqueda conjunta con tilt máximo $3^\circ $: área requerida mínima entre los semiángulos y patrones ensayados. Gris: ningún perfil tiene cobertura 3D completa. Cruces: el área requerida excede 150 mm$^2$. Los ejes representan candidatos discretos, no una interpolación continua de FOV o $K$.}}{22}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Alternativas no dominadas de recursos entre configuraciones que cumplen el objetivo de RMS y cobertura de PEB. Las líneas sólo conectan los candidatos discretos; no representan una optimización continua ni un coste económico del detector.}}{22}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparación de patrones dentro del límite de $3^\circ $, con el semiángulo y FOV del diseño seleccionado. Reducir las inclinaciones de parte de las normales no mejora aquí la sensibilidad transversal. Las curvas corresponden a perfiles antes del refinamiento local.}}{23}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Mapas de la configuración seleccionada, con $K=49$, $A=125\ \mathrm  {mm}^2$, $\Phi _{1/2}=60^\circ $ y todas las normales limitadas a $3^\circ $. Los mapas evalúan PEB de tres coordenadas, no una cota 2D con altura conocida.}}{23}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces PEB en la posición de referencia normalizado respecto al cono uniforme con $K_0=3$, usando el mismo denominador para todos los patrones. Las líneas ideales sólo se definen para $K\geq 3$ y asumen visibilidad completa. En presupuesto fijo, los pequeños cambios de los patrones no uniformes reflejan equilibrio angular y asignación, no nuevas muestras totales.}}{24}{figure.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.5}Uso de los nuevos archivos y límites de la recomendación}{24}{subsection.8.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Cobertura de luz, cobertura 3D y cobertura de PEB objetivo. El triplete repetido demuestra por qué más adquisiciones no necesariamente amplían la cobertura geométrica. Una curva saturada al 100\% puede seguir mejorando el PEB aunque ya no mejore identificabilidad.}}{25}{figure.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Presupuesto de muestras requerido frente a potencia para el objetivo de 2 cm y cobertura objetivo del 95\%, con el PD nominal, $K=9$ y tilt $3^\circ $. Las curvas son predicciones homoscedásticas; el ruido de disparo dependiente de potencia cambiaría esta ley.}}{26}{figure.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Cobertura 3D del conjunto de $K=9$ normales y límite geométrico optimista con los mismos límites angulares. La diferencia muestra cuánto queda por perder debido a un conjunto finito de orientaciones. Con tilt cero ninguna cantidad de muestras identifica tres coordenadas.}}{26}{figure.16}\protected@file@percent }
