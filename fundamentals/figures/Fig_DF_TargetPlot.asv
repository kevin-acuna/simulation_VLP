%% Fig_DF_TargetPlot.m
% "Target plot" for direction-finding stage — symmetric ring layout.
%
% Concept: orthographic projection of the unit sphere onto a 2D plane.
% Each testbed position defines a true direction n_d = (r - t)/||r - t||.
%   - Centre (0,0)  → position directly below the LED (theta_d = 0)
%   - Radius         → sin(theta_d) — proportional to angular offset
%   - Angle          → azimuth phi_d
%
% Positions are placed on 3 concentric rings (8 azimuths each, uniform 45°)
% at two receiver heights, snapped to the nearest grid node.
% For each position M_vis MC trials are run for GLS and NLS.
% DEB is shown as a circle of radius sin(DEB) in the orthographic projection.
%
% Author: Kevin Acuña

close all; clear variables; clc;
script_dir = fileparts(mfilename('fullpath'));
parent_dir = fileparts(script_dir);
addpath(fullfile(parent_dir, 'estimators'));  % system_params
addpath(fullfile(parent_dir, 'core'));        % vlp_gls, vlp_wls, DEB_complete, OWC_LOS_channel

%% =========================================================================
%  HYPERPARAMETERS
%% =========================================================================
rng(42);
M_vis     = 1;%120;      % MC trials per position
save_fig  = false;     % Save PNG to outputs/

% Ring geometry: floor radii [m] and azimuth offsets [deg]
ring_radii      = [0.4, 0.8, 1.2];      % horizontal distance from nadir [m]
ring_phi_offset = [0,  22.5, 0];        % azimuth offset per ring (stagger middle ring)
N_phi           = 8;                    % azimuths per ring

% Heights to display (different visual treatment)
z_layers = [0.2, 1.0];   % [m] — low and high receiver heights

%% =========================================================================
%  1. System Parameters
%% =========================================================================
system_params;
T_led = [0, 0, 2];           % LED position [m]
H_led = T_led(3);

% DEB-optimized orientations K=5
ori  = orientations_DEB_K5;
N_or = 5;
n_t  = zeros(N_or, 3);
for i = 1:N_or
    th = ori(2*i-1); ph = ori(2*i);
    n_t(i,:) = [sind(th)*cosd(ph), sind(th)*sind(ph), -cosd(th)];
end
param_r   = {A_det, n_r, FOV};
options_nl = optimoptions('fmincon','Display','none','Algorithm','sqp');

%% =========================================================================
%  2. Build symmetric position grid (rings × azimuths × heights)
%% =========================================================================
phi_base = 0:360/N_phi:359;   % base azimuths [deg]

pos_list = [];   % [x, y, z] rows
layer_id = [];   % which z-layer (1 or 2)

for l_idx = 1:numel(z_layers)
    z_rx = z_layers(l_idx);
    for r_idx = 1:numel(ring_radii)
        r_fl = ring_radii(r_idx);
        phi_vec = phi_base + ring_phi_offset(r_idx);
        for phi_deg = phi_vec
            % Ideal position
            x_ideal = r_fl * cosd(phi_deg);
            y_ideal = r_fl * sind(phi_deg);
            % Snap to nearest grid node
            x_snp = round(x_ideal / step) * step;
            y_snp = round(y_ideal / step) * step;
            % Keep within room bounds
            x_snp = max(-L/2, min(L/2, x_snp));
            y_snp = max(-W/2, min(W/2, y_snp));
            pos_list  = [pos_list;  x_snp, y_snp, z_rx]; %#ok<AGROW>
            layer_id  = [layer_id;  l_idx];                %#ok<AGROW>
        end
    end
end

% Remove duplicate (x,y,z) combinations
[pos_list, ia] = unique(pos_list, 'rows', 'stable');
layer_id = layer_id(ia);
N_pos_total = size(pos_list, 1);
fprintf('Total unique positions: %d\n', N_pos_total);

%% =========================================================================
%  3. Monte Carlo simulation
%% =========================================================================
fprintf('Running %d MC trials × %d positions...\n', M_vis, N_pos_total);

nd_true  = zeros(N_pos_total, 3);
nd_GLS   = cell(N_pos_total, 1);
nd_NLS   = cell(N_pos_total, 1);
DEB_vals = zeros(N_pos_total, 1);

for i_pos = 1:N_pos_total
    x = pos_list(i_pos,1);
    y = pos_list(i_pos,2);
    z = pos_list(i_pos,3);
    R_real = [x; y; z];
    v_true = (R_real - T_led') / norm(R_real - T_led');
    nd_true(i_pos,:) = v_true';

    % Clean channel powers
    P_clean = zeros(1, N_or);
    for i_dir = 1:N_or
        param_t = {T_led, n_t(i_dir,:), P_t, m_t};
        [~, P_clean(i_dir), ~, ~] = OWC_LOS_channel(x, y, z, param_t, param_r);
    end

    % DEB (radians)
    deb_val = DEB_complete(R_real, n_t', T_led', P_t, m_t, A_det, ...
        deg2rad(theta_half), deg2rad(FOV), sigma2, N_samples);
    DEB_vals(i_pos) = real(deb_val);

    % MC trials
    gls_est = zeros(M_vis, 3);
    nls_est = zeros(M_vis, 3);

    for mc = 1:M_vis
        P_raw   = repmat(P_clean, N_samples, 1) + sqrt(sigma2)*randn(N_samples, N_or);
        p_means = mean(P_raw, 1);

        % GLS
        d_hat = vlp_gls(n_t', P_raw, m_t, sigma2);
        gls_est(mc,:) = (d_hat / norm(d_hat))';

        % NLS
        max_p = max(p_means); if max_p <= 0; max_p = 1e-12; end
        p_tgt = p_means / max_p;
        [~, mx] = max(p_tgt);
        x0 = [n_t(mx,1), n_t(mx,2), n_t(mx,3), 1.0];
        lb = [-1,-1,-1,1e-3]; ub = [1,1,0,10];
        sol = fmincon(@(v) mle_cost_function(v, p_tgt, n_t, m_t), ...
                      x0, [], [], [], [], lb, ub, @sphere_constraint, options_nl);
        nls_est(mc,:) = (sol(1:3) / norm(sol(1:3)))';
    end

    nd_GLS{i_pos} = gls_est;
    nd_NLS{i_pos} = nls_est;

    if mod(i_pos, 8) == 0
        fprintf('  %d / %d done\n', i_pos, N_pos_total);
    end
end
fprintf('Done.\n');

%% =========================================================================
%  4. Figure — main axes + zoom inset
%% =========================================================================
% Layer visual parameters
alpha_layer = [0.55, 0.80];   % opacity per layer (low z = more transparent)
sz_est      = 7;
sz_true     = 100;

c_true = [0.08 0.08 0.08];
c_gls  = [0.13 0.47 0.71];
c_nls  = [0.20 0.63 0.17];
c_deb  = [0.85 0.10 0.10];

fig = figure('Units','centimeters','Position',[2 2 18 17], 'Color','white');
ax  = axes(fig, 'Position', [0.10 0.10 0.82 0.84]);
hold(ax, 'on');

% ---- Background: theta contours and azimuth spokes ----
theta_rings = [20, 40, 60];
for th = theta_rings
    phi_c = linspace(0, 2*pi, 300);
    plot(ax, sin(deg2rad(th))*cos(phi_c), sin(deg2rad(th))*sin(phi_c), ...
        '--', 'Color', [0.82 0.82 0.82], 'LineWidth', 0.7);
    ang_lbl = deg2rad(112);
    text(ax, sin(deg2rad(th))*cos(ang_lbl), sin(deg2rad(th))*sin(ang_lbl), ...
        sprintf('%d°',th), 'FontSize', 7.5, 'Color', [0.60 0.60 0.60], ...
        'HorizontalAlignment','center');
end
for phi_sp = 0:45:315
    r_max = sin(deg2rad(65));
    plot(ax, [0, r_max*cosd(phi_sp)], [0, r_max*sind(phi_sp)], ...
        '-', 'Color', [0.88 0.88 0.88], 'LineWidth', 0.55);
end

% ---- Data per position ----
for i_pos = 1:N_pos_total
    nd  = nd_true(i_pos,:);
    gls = nd_GLS{i_pos};
    nls = nd_NLS{i_pos};
    deb = DEB_vals(i_pos);
    al  = alpha_layer(layer_id(i_pos));

    % Scatter — note: orthographic proj = (nd(1), nd(2)) = (sin θ cos φ, sin θ sin φ)
    % BUT n_d in paper = [-sin θ cos φ, -sin θ sin φ, -cos θ]  (downward convention)
    % so the x,y of nd already give correct 2D projection (just flip sign for "map" view)
    px_nd  = -nd(1);  py_nd  = -nd(2);   % "map" projection (N=+y, E=+x from below)
    px_gls = -gls(:,1); py_gls = -gls(:,2);
    px_nls = -nls(:,1); py_nls = -nls(:,2);

    scatter(ax, px_gls, py_gls, sz_est, c_gls, 'filled', ...
        'MarkerFaceAlpha', al*0.50, 'MarkerEdgeAlpha', 0);
    scatter(ax, px_nls, py_nls, sz_est, c_nls, 'filled', ...
        'MarkerFaceAlpha', al*0.50, 'MarkerEdgeAlpha', 0);

    % DEB circle centred at true direction (tangent-plane approximation)
    phi_c  = linspace(0, 2*pi, 80);
    r_deb  = sin(deb);    % radius in orthographic projection ≈ DEB [rad]
    plot(ax, px_nd + r_deb*cos(phi_c), py_nd + r_deb*sin(phi_c), ...
        '-', 'Color', [c_deb, al*0.80], 'LineWidth', 1.2);

    % True direction (on top)
    if layer_id(i_pos) == 2
        scatter(ax, px_nd, py_nd, sz_true, c_true, 'x', 'LineWidth', 2.0);
    else
        scatter(ax, px_nd, py_nd, sz_true*0.7, c_true, '+', 'LineWidth', 1.4);
    end
end

% ---- Axis formatting ----
axis(ax, 'equal');
xlim(ax, [-0.78 0.78]); ylim(ax, [-0.78 0.78]);
xlabel(ax, '$\sin\theta_d\cos\phi_d$', 'Interpreter','latex','FontSize',11);
ylabel(ax, '$\sin\theta_d\sin\phi_d$', 'Interpreter','latex','FontSize',11);
set(ax,'FontSize',10,'Box','on','TickLabelInterpreter','latex','Layer','top');
grid(ax,'off');

% Cardinal labels
text(ax,  0, 0.82, 'N', 'FontSize',8,'Color',[0.45 0.45 0.45],'HorizontalAlignment','center');
text(ax,  0,-0.82, 'S', 'FontSize',8,'Color',[0.45 0.45 0.45],'HorizontalAlignment','center');
text(ax,  0.82, 0, 'E', 'FontSize',8,'Color',[0.45 0.45 0.45],'HorizontalAlignment','center');
text(ax, -0.82, 0, 'W', 'FontSize',8,'Color',[0.45 0.45 0.45],'HorizontalAlignment','center');

% ---- Legend ----
h_trueH = scatter(ax, NaN,NaN, 80, c_true,'x','LineWidth',2.0);
h_trueL = scatter(ax, NaN,NaN, 60, c_true,'+','LineWidth',1.4);
h_gls_h = scatter(ax, NaN,NaN, 30, c_gls, 'filled','MarkerFaceAlpha',0.75);
h_nls_h = scatter(ax, NaN,NaN, 30, c_nls, 'filled','MarkerFaceAlpha',0.75);
h_deb_h = plot(ax, NaN,NaN, '-', 'Color',c_deb,'LineWidth',1.5);

legend(ax, [h_trueH, h_trueL, h_gls_h, h_nls_h, h_deb_h], ...
    {sprintf('True $\\mathbf{n}_d$  ($z=%.1f$\\,m)',z_layers(2)), ...
     sprintf('True $\\mathbf{n}_d$  ($z=%.1f$\\,m)',z_layers(1)), ...
     'GLS estimates', 'NLS estimates', 'DEB ($1\\sigma$)'}, ...
    'Interpreter','latex','Location','northeast','FontSize',8.5,'Box','on');

hold(ax,'off');

% ---- Zoom inset (outer ring, one cluster) ----
% Pick the outermost-ring position closest to E (phi≈0, large r, layer 2)
[~, zoom_idx] = min(abs(pos_list(:,2)) + abs(pos_list(:,1)-1.2) + ...
    abs(pos_list(:,3)-z_layers(2)));
nd_z  = nd_true(zoom_idx,:);
px_z  = -nd_z(1); py_z = -nd_z(2);

ax_in = axes(fig, 'Position', [0.60 0.09 0.30 0.30]);
hold(ax_in,'on');
box(ax_in,'on');

gls_z = nd_GLS{zoom_idx};
nls_z = nd_NLS{zoom_idx};
scatter(ax_in, -gls_z(:,1), -gls_z(:,2), 10, c_gls, 'filled','MarkerFaceAlpha',0.55);
scatter(ax_in, -nls_z(:,1), -nls_z(:,2), 10, c_nls, 'filled','MarkerFaceAlpha',0.55);
deb_z = DEB_vals(zoom_idx);
phi_c = linspace(0,2*pi,80);
plot(ax_in, px_z + sin(deb_z)*cos(phi_c), py_z + sin(deb_z)*sin(phi_c), ...
    '-', 'Color', c_deb, 'LineWidth',1.8);
scatter(ax_in, px_z, py_z, 120, c_true, 'x', 'LineWidth', 2.5);

% Inset axes tight around that cluster
pad = max(sin(deb_z)*3, 0.025);
xlim(ax_in, [px_z-pad, px_z+pad]);
ylim(ax_in, [py_z-pad, py_z+pad]);
axis(ax_in,'equal');
set(ax_in,'FontSize',7,'TickLabelInterpreter','latex','XTick',[],'YTick',[]);
title(ax_in,'Zoom (outer ring)','Interpreter','latex','FontSize',7.5);

hold(ax_in,'off');

% Draw rectangle on main axes indicating zoom region
rectangle(ax,'Position',[px_z-pad, py_z-pad, 2*pad, 2*pad], ...
    'EdgeColor',[0.4 0.4 0.4],'LineWidth',0.9,'LineStyle','--');

%% =========================================================================
%  5. Save
%% =========================================================================
if save_fig
    out_dir = fullfile(script_dir, 'outputs');
    if ~exist(out_dir,'dir'); mkdir(out_dir); end
    out_path = fullfile(out_dir, 'Fig_DF_TargetPlot.png');
    exportgraphics(fig, out_path, 'Resolution', 300);
    fprintf('Saved → %s\n', out_path);
end

%% =========================================================================
%  LOCAL FUNCTIONS (copied from run_DF_comparison_MC_parallel.m)
%% =========================================================================
function F = mle_cost_function(vars, p_target, n_t, m_t)
    v   = vars(1:3)';
    eta = vars(4);
    F   = 0;
    for k = 1:size(n_t,1)
        q = max(0, dot(n_t(k,:), v));
        F = F + (eta * q^m_t - p_target(k))^2;
    end
end

function [c, ceq] = sphere_constraint(vars)
    c   = [];
    ceq = vars(1)^2 + vars(2)^2 + vars(3)^2 - 1;
end
