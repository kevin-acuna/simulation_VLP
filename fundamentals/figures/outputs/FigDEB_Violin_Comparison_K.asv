%% FigDEB_Violin_Comparison_K.m
% IEEE TCOM — Split violin: DEB distribution for optimized vs random LED orientations
% K = 3..9. All system parameters loaded from system_params.m.
%
% Author: Kevin Acuña
close all; clear variables; clc;
rng(43);

%% ===== FLAGS =====
SAVE_OUTPUT    = true;    % true → export PNG + PDF to outputs/ ; false → screen only
RECOMPUTE      = true;    % false → load previously saved DEB_violin_data.mat

%% ===== PATHS =====
script_dir  = fileparts(mfilename('fullpath'));
core_dir    = fullfile(script_dir, '..', 'core');
param_dir   = fullfile(script_dir, '..', 'estimators');
out_dir     = fullfile(script_dir, 'outputs');
data_file   = fullfile(out_dir, 'DEB_violin_data.mat');

addpath(core_dir);
addpath(param_dir);
if SAVE_OUTPUT && ~exist(out_dir, 'dir'), mkdir(out_dir); end

%% ===== LOAD SYSTEM PARAMETERS =====
run('system_params.m');           % loads: P_t, m_t, A_det, FOV, sigma2, N_samples,
                                  %        L, W, Hmax, step, stepH,
                                  %        orientations_DEB_K3..K9, etc.
T = [0; 0; 2];                   % LED position [m]  (ceiling, room centre)
FOV_rad = deg2rad(FOV);

%% ===== FIGURE SETTINGS =====
K_values       = 3:9;
N_realizations = 1;              % random sets per K value
theta_max_rand = 70;              % max elevation for random orientations [deg]
Y_MAX          = 3.5;             % clip DEB display at this value [deg] — tail suppression
MAX_DEB_DEG    = 15;              % discard positions with DEB above this [deg] (near-singular FIM)

%% ===== DEB-OPTIMIZED ORIENTATIONS (from system_params) =====
ori_opt = containers.Map('KeyType','int32','ValueType','any');
ori_opt(3) = orientations_DEB_K3;
ori_opt(4) = orientations_DEB_K4;
ori_opt(5) = orientations_DEB_K5;
ori_opt(6) = orientations_DEB_K6;
ori_opt(7) = orientations_DEB_K7;
ori_opt(8) = orientations_DEB_K8;
ori_opt(9) = orientations_DEB_K9;

%% ===== TESTBED =====
[X, Y, Z] = meshgrid(-L/2:step:L/2, -W/2:step:W/2, 0:stepH:Hmax);
X_r = X(:); Y_r = Y(:); Z_r = Z(:);
fprintf('Testbed: %d positions (step=%.2f m)\n', numel(X_r), step);

%% ===== COMPUTE / LOAD DEB DATA =====
if ~RECOMPUTE && exist(data_file, 'file')
    fprintf('Loading cached data from:\n  %s\n', data_file);
    load(data_file, 'deb_optimized', 'deb_random');
else
    deb_optimized = cell(length(K_values), 1);
    deb_random    = cell(length(K_values), 1);

    for idx = 1:length(K_values)
        K = K_values(idx);
        fprintf('\n===== K = %d =====\n', K);

        % --- Optimized ---
        fprintf('  Optimized ... ');
        warning('off','MATLAB:nearlySingularMatrix');
        tic;
        deb_optimized{idx} = eval_deb(ori_opt(K), X_r, Y_r, Z_r, T, ...
            P_t, m_t, A_det, FOV_rad, sigma2, N_samples, MAX_DEB_DEG);
        warning('on','MATLAB:nearlySingularMatrix');
        fprintf('%.1f s  |  %d valid positions\n', toc, numel(deb_optimized{idx}));

        % --- Random ---
        fprintf('  Random (%d sets): ', N_realizations);
        all_rand = [];
        for r = 1:N_realizations
            if mod(r,10)==0, fprintf('%d ', r); end
            ori_r = rand_orientations(K, theta_max_rand);
            warning('off','MATLAB:nearlySingularMatrix');
            vals  = eval_deb(ori_r, X_r, Y_r, Z_r, T, ...
                P_t, m_t, A_det, FOV_rad, sigma2, N_samples, MAX_DEB_DEG);
            warning('on','MATLAB:nearlySingularMatrix');
            all_rand = [all_rand; vals]; %#ok<AGROW>
        end
        deb_random{idx} = all_rand;
        fprintf('\n  Total random values: %d\n', numel(all_rand));
    end

    if SAVE_OUTPUT
        save(data_file, 'K_values', 'deb_optimized', 'deb_random', 'N_realizations');
        fprintf('\nData cached: %s\n', data_file);
    end
end

%% ===== SUMMARY TABLE =====
fprintf('\n%s\n', repmat('=',1,55));
fprintf('%-4s  %-12s  %-12s  %-10s\n','K','RMS-DEB opt','RMS-DEB rand','Improvement');
fprintf('%s\n', repmat('-',1,55));
for idx = 1:length(K_values)
    d_o = rad2deg(deb_optimized{idx});
    d_r = rad2deg(deb_random{idx});
    if ~isempty(d_o) && ~isempty(d_r)
        ro = sqrt(mean(d_o.^2)); rr = sqrt(mean(d_r.^2));
        fprintf('%-4d  %6.3f°       %6.3f°       %+.1f%%\n', ...
            K_values(idx), ro, rr, (rr-ro)/rr*100);
    end
end
fprintf('%s\n', repmat('=',1,55));

%% ===== PLOT =====
fig = figure('Units','inches','Position',[1 1 7.16 3.5], 'Color','w');

color_opt  = [0.298, 0.686, 0.314];   % green  (IEEE-friendly)
color_rand = [0.957, 0.643, 0.376];   % orange
bx_w       = 0.06;                    % boxplot box half-width
max_hw     = 0.38;                    % max half-width of violin
y_grid     = linspace(0, Y_MAX, 400); % common y-axis grid

hold on;
for idx = 1:length(K_values)
    K  = K_values(idx);
    xc = K;

    % Convert to degrees and clip tails for display
    d_opt  = min(rad2deg(deb_optimized{idx}), Y_MAX);
    d_rand = min(rad2deg(deb_random{idx}),    Y_MAX);
    if isempty(d_opt) || isempty(d_rand), continue; end

    % KDE — bandwidth via Silverman's rule
    bw_o = max(1.06 * std(d_opt)  * numel(d_opt)^(-0.2),  0.02);
    bw_r = max(1.06 * std(d_rand) * numel(d_rand)^(-0.2), 0.02);
    [f_o, ~] = ksdensity(d_opt,  y_grid, 'Bandwidth', bw_o);
    [f_r, ~] = ksdensity(d_rand, y_grid, 'Bandwidth', bw_r);

    % Normalize each half independently to max_hw
    f_on = f_o / max(f_o) * max_hw;
    f_rn = f_r / max(f_r) * max_hw;

    % Left half — optimized
    fill([xc - f_on, fliplr(xc*ones(1,numel(f_on)))], ...
         [y_grid,    fliplr(y_grid)], ...
         color_opt, 'EdgeColor',[0.15 0.15 0.15],'LineWidth',0.35,'FaceAlpha',0.72);

    % Right half — random
    fill([xc*ones(1,numel(f_rn)), fliplr(xc + f_rn)], ...
         [y_grid,                 fliplr(y_grid)], ...
         color_rand,'EdgeColor',[0.15 0.15 0.15],'LineWidth',0.35,'FaceAlpha',0.72);

    % Boxplot — optimized (left)
    draw_box(xc-0.13, bx_w, d_opt,  color_opt);

    % Boxplot — random (right)
    draw_box(xc+0.13, bx_w, d_rand, color_rand);
end

% Formatting
set(gca,'FontName','Times New Roman','FontSize',9);
xlabel('Number of orientations ($K$)', 'Interpreter','latex','FontSize',10);
ylabel('DEB [$^\circ$]',              'Interpreter','latex','FontSize',10);
xlim([min(K_values)-0.55, max(K_values)+0.55]);
ylim([0, Y_MAX]);
xticks(K_values);
grid on;
set(gca,'GridAlpha',0.15,'GridLineStyle','-','TickLabelInterpreter','latex');
box on;

h1 = patch(NaN,NaN,color_opt, 'FaceAlpha',0.72,'EdgeColor',[0.15 0.15 0.15],'LineWidth',0.35);
h2 = patch(NaN,NaN,color_rand,'FaceAlpha',0.72,'EdgeColor',[0.15 0.15 0.15],'LineWidth',0.35);
legend([h1,h2],{'Optimized','Random'},'Location','northeast', ...
    'FontSize',8,'Interpreter','latex','Box','on');

%% ===== EXPORT =====
if SAVE_OUTPUT
    exportgraphics(fig, fullfile(out_dir,'DEB_violin_comparison.png'), 'Resolution',600);
    exportgraphics(fig, fullfile(out_dir,'DEB_violin_comparison.pdf'), 'ContentType','vector');
    fprintf('\nFigures saved to:\n  %s\n', out_dir);
end

%% ===== LOCAL FUNCTIONS =====
function deb_vals = eval_deb(orientations, X_r, Y_r, Z_r, T, P_t, m_t, A_det, FOV_rad, sigma2, N_samples, max_deb_deg)
    K   = numel(orientations) / 2;
    nt  = zeros(3, K);
    for i = 1:K
        th = orientations(2*i-1); ph = orientations(2*i);
        nt(:,i) = [sind(th)*cosd(ph); sind(th)*sind(ph); -cosd(th)];
    end
    N_pos = numel(X_r);
    raw   = nan(N_pos, 1);
    for j = 1:N_pos
        R   = [X_r(j); Y_r(j); Z_r(j)];
        val = DEB_complete(R, nt, T, P_t, m_t, A_det, 0, FOV_rad, sigma2, N_samples);
        if isfinite(val) && isreal(val) && val > 0 && rad2deg(val) < max_deb_deg
            raw(j) = val;
        end
    end
    deb_vals = raw(~isnan(raw));
end

function ori = rand_orientations(K, theta_max)
    ori = zeros(1, 2*K);
    for i = 1:K
        ori(2*i-1) = rand() * theta_max;
        ori(2*i)   = rand() * 360;
    end
end

function draw_box(xc, bw, data, clr)
    q1 = prctile(data,25); md = median(data); q3 = prctile(data,75);
    p5 = prctile(data,5);  p95 = prctile(data,95);
    rectangle('Position',[xc-bw/2, q1, bw, q3-q1], ...
        'FaceColor',clr,'EdgeColor','k','LineWidth',0.5);
    line([xc-bw/2, xc+bw/2],[md, md],'Color','k','LineWidth',1.0);
    line([xc, xc],[q3, p95],'Color','k','LineWidth',0.5);
    line([xc, xc],[q1, p5], 'Color','k','LineWidth',0.5);
    line([xc-bw/4, xc+bw/4],[p95,p95],'Color','k','LineWidth',0.5);
    line([xc-bw/4, xc+bw/4],[p5, p5], 'Color','k','LineWidth',0.5);
end
