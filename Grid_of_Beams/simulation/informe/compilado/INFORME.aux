\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Errores de ganancia, curvatura, geometría y orientación. Estos ensayos paramétricos no sustituyen una simulación de estimación sobre irradiancias aberradas reales.}}{23}{figure.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Comprobación física: no aceptar una solución solo por su CDF}{23}{subsection.6.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Emisor de esquina: comparación entre segundos momentos del trazado y la aproximación circular proyectada. Cada fila utiliza 200000 rayos.}}{23}{table.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Comparación completa de quince configuraciones. Una razón de radios cercana a uno favorece la aproximación; grandes diferencias o desplazamientos de centroide invalidan una lectura literal de las CDF concordantes.}}{24}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Visualización de rayos de esquina y del contorno predicho por el Gaussian circular. El cambio a focal negativa fuerte requiere más que reutilizar un único ancho circular.}}{24}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Tiempo, área y complejidad}{25}{subsection.6.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Sensibilidad del núcleo de un tile al área y a la banda de medida. Aumentar banda acorta integración. Se mantiene fija la electrónica y la corriente de fondo, por lo que no se está diseñando la capacitancia ni el amplificador de un PD mayor.}}{25}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Mejor fracción de puntos con PEB inferior a 10 cm entre los estados muestreados de cada grupo, en el noveno nominal. La selección procede de una malla finita: no es un óptimo global ni una garantía de cobertura continua.}}{25}{figure.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Repetir la misma focal frente a variar la curvatura, con el mismo dominio y presupuesto de integración. Promediar fluctuaciones independientes no equivale a generar gradientes espaciales nuevos.}}{26}{figure.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Inclinación de los tiles periféricos y fracción de puntos localmente favorables del AP. Se muestran cuatro de los seis conjuntos de estados para facilitar la lectura; todos se conservan en CSV. Los conjuntos con R=10 mm siguen sujetos a la advertencia de aberraciones.}}{26}{figure.15}\protected@file@percent }
